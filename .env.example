
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_strong_password
DB_DATABASE=ecommerce

CUSTOMER_JWT_SECRET=your_customer_secret_at_least_32_bytes
ADMIN_JWT_SECRET=your_admin_secret_at_least_32_bytes

CUSTOMER_JWT_EXPIRES_IN=15m
ADMIN_JWT_EXPIRES_IN=15m

PORT=3000

# Both admin inventory and order checkout use this backend.
INVENTORY_DRIVER=typeorm
WAREHOUSE_GRPC_URL=localhost:50051
WAREHOUSE_GRPC_TIMEOUT_MS=3000

SEED_ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_CUSTOMER_PASSWORD=replace_with_a_strong_customer_password
SEED_SYNC_SCHEMA=true

# Requirement 3: local read replica and public catalog cache.
DB_REPLICATION_PASSWORD=replace_with_a_strong_replication_password
DB_READ_REPLICA_ENABLED=true
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5435
CATALOG_CACHE_ENABLED=true
CATALOG_CACHE_TTL_SECONDS=30
REDIS_URL=redis://localhost:6379

# Keep the normal API protected. The isolated benchmark sets a higher limit.
HTTP_RATE_LIMIT=100
ASYNC_EVENTS_ENABLED=true
RABBITMQ_USERNAME=ecommerce
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
RABBITMQ_URL=amqp://ecommerce:replace-with-a-local-rabbitmq-password@localhost:5672
PUSHER_APP_ID=ecommerce
PUSHER_APP_KEY=ecommerce-local
PUSHER_APP_SECRET=replace-with-a-local-pusher-secret
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_PUBLIC_HOST=localhost
PUSHER_PUBLIC_PORT=6001
PUSHER_PUBLIC_TLS=false
# mailpit = local test inbox; smtp = real Gmail/provider delivery.
EMAIL_TRANSPORT=mailpit
EMAIL_MAX_ATTEMPTS=4
EMAIL_RETRY_DELAY_MS=5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STOREFRONT_URL=http://localhost:5173
MAIL_CURRENCY=USD
