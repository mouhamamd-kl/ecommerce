
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_strong_password
DB_DATABASE=ecommerce

CUSTOMER_JWT_SECRET=your_customer_secret_at_least_32_bytes
ADMIN_JWT_SECRET=your_admin_secret_at_least_32_bytes

CUSTOMER_JWT_EXPIRES_IN=15m
ADMIN_JWT_EXPIRES_IN=15m

PORT=3000

# Both admin inventory and order checkout use this backend.
INVENTORY_DRIVER=typeorm
WAREHOUSE_GRPC_URL=localhost:50051
WAREHOUSE_GRPC_TIMEOUT_MS=3000

SEED_ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_CUSTOMER_PASSWORD=replace_with_a_strong_customer_password
SEED_SYNC_SCHEMA=true
